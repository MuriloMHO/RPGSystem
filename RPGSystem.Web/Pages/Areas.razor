@page "/areas"

@inject GameSessionState CurrentSession
@inject NavigationManager Navigation

@using RPGSystem.Areas
@using RPGSystem.Areas.AreaTypes

<div id="areas-container">
    <a href="mainmenu">Main Menu</a>

    @if (CurrentSession?.CurrentGame != null)
    {
        <div id="character-profile">
            <img src="@CreatePath.CreateCharacterPath(CurrentSession.CurrentGame.Player)" id="stats-img" />
            <div id="character-stats">
                <p>Name: @CurrentSession.CurrentGame.Player.Name</p>
                <p>Level: @CurrentSession.CurrentGame.Player.Level</p>
                <p>HP: @CurrentSession.CurrentGame.Player.Health/@CurrentSession.CurrentGame.Player.MaxHealth</p>
            </div>
        </div>

        @if (selectedArea != null)
        {
            <div id="selected-area">
                <h1 id="area-info-title">Area Info</h1>

                <p>@selectedArea.Name</p>

                <p>Required Level: @selectedArea.RequiredLevel</p>

                <button disabled="@(selectedArea == null)" @onclick="() => SelectArea(null)">Unselect Area</button>

                <button disabled="@(selectedArea == null || CurrentSession.CurrentGame == null)" @onclick="BeginEncounter">Begin Encounter</button>
            </div>
        }

        @foreach (Area area in areas)
        {
            <button @onclick="() => SelectArea(area)" class="select-area-button">
                <p>@area.Name</p>
                <img src="@CreatePath.CreateAreaPath(area)" class="area-selection-img"/>
            </button>
        }

        @if (CurrentSession?.CurrentGame?.CurrentEncounter?.Area != null &&
            CurrentSession.CurrentGame.CurrentEncounter.Status == Coordinators.EncounterStatus.Active)
        {
            Navigation.NavigateTo("encounter");
        }
        else if (encounterStarted == false)
        {
            <p>Could not Start an Encounter</p>
        }
    }
    else
    {
        <p>No active game found</p>
    }
</div>

@code{
    List<Area> areas = [
    new GreenFields(),
    new DarkForest(),
    new OrcCamp(),
    new RuinedHighlands(),
    new CursedCrypt(),
    new DarkCitadel()
    ];

    Area? selectedArea;

    bool? encounterStarted = null;

    private void SelectArea(Area? area)
    {
        selectedArea = area;
    }

    private void BeginEncounter()
    {
        if (selectedArea != null && CurrentSession.CurrentGame != null)
        {
            encounterStarted = CurrentSession.CurrentGame.NewEncounter(selectedArea);
        }
    }
}