@page "/inventory"
@inject GameSessionState CurrentSession
@using RPGSystem.Items
@using RPGSystem.Items.ItemTypes
@using RPGSystem.Interfaces

<div id="inventory-container">

    @if (CurrentSession.CurrentGame?.Player != null)
    {
        <a href="mainmenu">Main Menu</a>

        @if (CurrentSession.CurrentGame?.CurrentEncounter != null &&
            (CurrentSession.CurrentGame.CurrentEncounter.Status == Coordinators.EncounterStatus.Active ||
            CurrentSession.CurrentGame.CurrentEncounter.Status == Coordinators.EncounterStatus.Victory))
        {
            <a href="encounter">View Encounter</a>
        }

        <div id="character-profile">
            <img src="@CreatePath.CreateCharacterPath(CurrentSession.CurrentGame.Player)" id="stats-img" />
            <div id="character-stats">
                <p>Name: @CurrentSession.CurrentGame.Player.Name</p>
                <p>Level: @CurrentSession.CurrentGame.Player.Level</p>
                <p>HP: @CurrentSession.CurrentGame.Player.Health/@CurrentSession.CurrentGame.Player.MaxHealth</p>
            </div>
        </div>

        <h1 class="inventory-title">Inventory</h1>

        @if (selectedItem != null)
        {
            <div id="item-stats">
                <h1 class="inventory-title">
                    Item Info
                </h1>
                <p>@selectedItem.Name</p>
                @if (selectedItem is Elixir)
                {
                    <p>Effect: Restores HP to maximum.</p>
                }
                else if (selectedItem is IItemHealAble)
                {
                    <p>Effect: Restores @selectedItem.Value HP.</p>
                }
                else if (selectedItem is IItemDamageAble)
                {
                    <p>Effect: Deals @selectedItem.Value damage.</p>
                }

                <button disabled="@(selectedItem == null)" @onclick="() => Select(null)" class="item-usage">Clear Selection</button>

                <button disabled="@(!canBeUsed)" @onclick="UseItemInventory" class="item-usage">Use Item</button>
            </div>

        }

        @foreach (Item item in CurrentSession.CurrentGame.Player.Inventory)
        {
            <button @onclick="() => Select(item)" class="items">
                @item.Name
            </button>
        }

        @if (CurrentSession.CurrentGame != null &&
            CurrentSession.CurrentGame.Player.Inventory.Count < 1)
        {
            <p>Inventory is empty</p>
        }
    }
</div>

@code{
    Item? selectedItem;

    bool canBeUsed = true;

    private void Select(Item? item)
    {
        selectedItem = item;
        canBeUsed = true;
    }

    private void UseItemInventory()
    {
        if (selectedItem != null && CurrentSession.CurrentGame != null)
        {
            if (CurrentSession?.CurrentGame?.CurrentEncounter != null &&
                CurrentSession.CurrentGame.CurrentEncounter.Status == Coordinators.EncounterStatus.Active)
            {
                canBeUsed = CurrentSession.CurrentGame.CurrentEncounter.UseItem(selectedItem);
            }
            else
            {
                canBeUsed = CurrentSession!.CurrentGame.UseItemOutOfBattle(selectedItem);
            }

            if (canBeUsed)
            {
                selectedItem = null;
            }
        }
    }
}