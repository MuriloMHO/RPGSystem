@page "/encounter"

@inject GameSessionState CurrentSession
@inject NavigationManager Navigation

<div id="encounter-container">
    @if (CurrentSession?.CurrentGame != null)
    {
        @if (CurrentSession.CurrentGame.CurrentEncounter != null)
        {
            @if (CurrentSession.CurrentGame.CurrentEncounter.Area != null &&
                CurrentSession.CurrentGame.CurrentEncounter.Enemy != null)
            {
                <div id="game-info">
                    <p id="player-stats">HP: @CurrentSession.CurrentGame.Player.Health/@CurrentSession.CurrentGame.Player.MaxHealth</p>
                    <p id="turns">Turn: @CurrentSession.CurrentGame.CurrentEncounter.TurnCount</p>
                    <p id="enemy-stats">HP: @CurrentSession.CurrentGame.CurrentEncounter.Enemy.Health/@CurrentSession.CurrentGame.CurrentEncounter.Enemy.MaxHealth</p>
                </div>

                <div id="battle-container"
                         style="background-image: url('@CreatePath.CreateAreaPath(CurrentSession.CurrentGame.CurrentEncounter.Area)')">
                    <img src="@CreatePath.CreateCharacterPath(CurrentSession.CurrentGame.Player)" id="player-img"/>

                    <img src="@CreatePath.CreateCharacterPath(CurrentSession.CurrentGame.CurrentEncounter.Enemy)" id="enemy-img"/>
                </div>


                <div id="menus">
                    <div id="stats-display">
                        <p>@CurrentSession.CurrentGame.Player.Name</p>
                        <p>Level: @CurrentSession.CurrentGame.Player.Level</p>
                        <p>Gold: @CurrentSession.CurrentGame.Player.Gold</p>
                    </div>


                    <div id="battle-log">
                    </div>

                    <div id="actions">
                        <button disabled="@(CurrentSession.CurrentGame.CurrentEncounter.Status != Coordinators.EncounterStatus.Active)" @onclick="EncounterAttack" class="action-button">Attack</button>
                        <button disabled="@(CurrentSession.CurrentGame.Player.SkillCooldown > 0 || CurrentSession.CurrentGame.CurrentEncounter.Status != Coordinators.EncounterStatus.Active)" @onclick="EncounterSkill" class="action-button">Skill: @CurrentSession.CurrentGame.Player.SkillCooldown</button>
                        <a href="inventory" class="action-button">Inventory</a>
                        <button disabled="@(CurrentSession.CurrentGame.CurrentEncounter.Status != Coordinators.EncounterStatus.Active)" @onclick="EncounterFlee" class="action-button">Flee</button>
                    </div>
                </div>
                

                @if (CurrentSession.CurrentGame.CurrentEncounter.Status == Coordinators.EncounterStatus.Victory)
                {
                    <p>You won the battle</p>
                    <a href="areas">Areas</a>
                }
                else if (CurrentSession.CurrentGame.CurrentEncounter.Status == Coordinators.EncounterStatus.Escaped)
                {
                    Navigation.NavigateTo("areas");
                }
                else if (CurrentSession.CurrentGame.CurrentEncounter.Status == Coordinators.EncounterStatus.Defeat)
                {
                    Navigation.NavigateTo("");
                }
            }
            else
            {
                <p>No active encounter found</p>
            }
        }
        else
        {
            <p>No encounter found</p>
        }
    }
    else
    {
        <p>No active game found</p>
    }
</div>

@code{
    private void EncounterAttack()
    {
        if(CurrentSession?.CurrentGame?.CurrentEncounter != null)
        {
            CurrentSession.CurrentGame.CurrentEncounter.Attack();
        }
    }
    private void EncounterSkill()
    {
        if (CurrentSession?.CurrentGame?.CurrentEncounter != null)
        {
            CurrentSession.CurrentGame.CurrentEncounter.Skill();
        }
    }
    private void EncounterFlee()
    {
        if (CurrentSession?.CurrentGame?.CurrentEncounter != null)
        {
            CurrentSession.CurrentGame.CurrentEncounter.Flee();
        }
    }
}