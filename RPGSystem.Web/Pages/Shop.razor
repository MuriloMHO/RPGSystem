@page "/shop"

@inject GameSessionState CurrentSession
@using RPGSystem.Items
@using RPGSystem.Items.ItemTypes
@using RPGSystem.Interfaces

<div id="shop-container">
    @if (CurrentSession.CurrentGame != null)
    {
        <a href="mainmenu">Main Menu</a>

        <div id="character-profile">
            <img src="@CreatePath.CreateCharacterPath(CurrentSession.CurrentGame.Player)" id="stats-img" />
            <div id="character-stats">
                <p>Name: @CurrentSession.CurrentGame.Player.Name</p>
                <p>Level: @CurrentSession.CurrentGame.Player.Level</p>
                <p>Gold: @CurrentSession.CurrentGame.Player.Gold</p>
            </div>
        </div>

        <h1 class="item-to-buy-title">
            Shop
        </h1>

        @if (selectedItem != null)
        {
            <div id="item-to-buy">
                <h1 class="item-to-buy-title">
                    Item Info
                </h1>
                <p>@selectedItem.Name</p>
                @if (selectedItem is Elixir)
                {
                    <p>Effect: Restores HP to maximum.</p>
                }
                else if (selectedItem is IItemHealAble)
                {
                    <p>Effetc: Restores @selectedItem.Value HP.</p>
                }
                else if (selectedItem is IItemDamageAble)
                {
                    <p>Effetc: Deals @selectedItem.Value damage.</p>
                }

                <button disabled="@(selectedItem == null)" @onclick="() => Select(null)" class="item-to-buy-button">Clear Selection</button>

                <button @onclick="BuyItem" class="item-to-buy-button">Buy Item</button>
            
                @if (selectedItem != null && bought == true)
                {
                    <p>Thanks for buying @selectedItem.Name.</p>
                }
                else if (bought == false)
                {
                    <p>Sorry, transaction failed</p>
                }
            </div>
        }

        @foreach (Item item in CurrentSession.CurrentGame.ItemsToSell)
        {
            <button @onclick="() => Select(item)" class="items-available">
                @item.Name
            </button>
        }
    }
</div>

@code {
    Item? selectedItem;

    bool? bought = null;

    private void Select(Item? item)
    {
        selectedItem = item;
        bought = null;
    }

    private void BuyItem()
    {
        if (CurrentSession.CurrentGame != null)
        {
            bought = CurrentSession.CurrentGame.BuyFromShop(selectedItem);
        }
    }
}