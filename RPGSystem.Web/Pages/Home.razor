@page "/"

@inject GameSessionState CurrentSession
@inject NavigationManager Navigation

@using RPGSystem.Characters.Players
@using RPGSystem.Characters.Players.PlayerClasses

<div id="character-selection-container">
    <input @bind="playerName" placeholder="Name*" />

    <div class="character-selection-div">
        <button @onclick="ChooseKnight" class="character-selection-button">Knight</button>
        <img src="@CreatePath.CreateCharacterPath(new Knight(""))" class="character-selection-img" />
    </div>

    <div class="character-selection-div">
        <button @onclick="ChooseArcher" class="character-selection-button">Archer</button>
        <img src="@CreatePath.CreateCharacterPath(new Archer(""))" class="character-selection-img" />
    </div>

    <div class="character-selection-div">
        <button @onclick="ChooseMage" class="character-selection-button">Mage</button>
        <img src="@CreatePath.CreateCharacterPath(new Mage(""))" class="character-selection-img" />
    </div>

    @if (CurrentSession.CurrentGame != null && CurrentSession.CurrentGame.Player.Name != null)
    {
        Navigation.NavigateTo("mainmenu");
    }
</div>

@code {
    string? playerName;

    Player? player;

    public void ChooseKnight()
    {
        player = new Knight(playerName);

        CurrentSession.CurrentGame = new(player);
    }
    public void ChooseArcher()
    {
        player = new Archer(playerName);

        CurrentSession.CurrentGame = new(player);
    }
    public void ChooseMage()
    {
        player = new Mage(playerName);

        CurrentSession.CurrentGame = new(player);
    }
}